{
  "name": "ngx-fabric-wrapper",
  "description": "Angular wrapper library for Fabric",
  "bugs": "https://github.com/zefoy/ngx-fabric-wrapper/issues",
  "version": "21.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "start": "ng serve app",
    "build": "ng build lib",
    "deploy": "deploy-to-git",
    "prepare": "ng build lib --configuration production",
    "publish": "npm publish ./dist/lib",
    "predeploy": "rimraf ./dist/app && mkdirp ./dist/app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zefoy/ngx-fabric-wrapper.git"
  },
  "config": {
    "deployToGit": {
      "repository": "git@github.com:zefoy/ngx-fabric-wrapper.git",
      "branch": "gh-pages",
      "folder": "dist/app",
      "script": "ng build app --configuration production --base-href=ngx-fabric-wrapper --delete-output-path=false",
      "commit": "Publishing $npm_package_version",
      "user": {
        "name": "ZEF Devel",
        "email": "devel@zef.fi"
      }
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "core-js": "^3.50.0",
    "fabric": "^7.4.0",
    "resize-observer-polyfill": "^1.5.1",
    "rxjs": "^7.8.2",
    "tailwindcss": "^3.4.19",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript-eslint/types": "^8.66.0",
    "@typescript-eslint/utils": "^8.66.0",
    "angular-eslint": "^22.1.0",
    "cpx": "^1.5.0",
    "deploy-to-git": "^0.4.0",
    "eslint": "^10.8.0",
    "mkdirp": "^3.0.0",
    "ng-packagr": "^22.1.1",
    "rimraf": "^6.0.0",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.0",
    "terser": "^5.43.0",
    "tslib": "^2.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "watch": "^1.0.0"
  }
}
